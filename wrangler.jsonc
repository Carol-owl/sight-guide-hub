{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sight-guide-hub",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  // O build (vite build) força o preset Nitro `cloudflare-module` em vite.config.ts e gera:
  //   - dist/server/index.mjs  → bundle final do Worker (já com os módulos
  //                                virtuais do TanStack Start resolvidos)
  //   - dist/client/           → assets estáticos servidos pelo binding ASSETS
  //   - dist/server/wrangler.json → config automática gerada pelo Nitro
  //
  // Com isto, `npx wrangler deploy` na raiz funciona sem flags extras.
  "main": "dist/server/index.mjs",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"]
    }
  ]
}
