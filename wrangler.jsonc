{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sight-guide-hub",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  // O build (vite build) usa o preset Nitro `cloudflare-module` e gera:
  //   - .output/server/index.js  → bundle final do Worker (já com os módulos
  //                                   virtuais do TanStack Start resolvidos)
  //   - .output/public/            → assets estáticos servidos pelo binding ASSETS
  //
  // Com isto, `npx wrangler deploy` na raiz funciona sem flags extras.
  "main": ".output/server/index.js",
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"]
    }
  ]
}
